function ascendDescend(length, minimum, maximum) {
  if (maximum < minimum || length === 0) return "";
​
  if (minimum === maximum) {
    return String(minimum).repeat(length).slice(0, length);
  }
​
  let result = "";
  let value = minimum;
  let direction = 1;
​
  while (result.length < length) {
    result += value;
​
    if (value === maximum) direction = -1;
    else if (value === minimum) direction = 1;
​
    value += direction;
  }
​
  return result.slice(0, length);
}